<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: usa o PNG cheio como background (edge-to-edge). O launcher
  aplica só a máscara de shape (círculo/squircle) sobre a arte, sem embrulhar
  em moldura branca — que é o que Android faz com legacy icons sem este XML.
  Foreground é transparente porque a arte inteira já está no PNG de fundo.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_full" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
