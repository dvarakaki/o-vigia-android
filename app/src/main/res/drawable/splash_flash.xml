<?xml version="1.0" encoding="utf-8"?>
<!--
  Estouro: o clarão branco-dourado do instante em que o olho abre. Aparece e
  some em menos de meio segundo, cobrindo a troca do splash do sistema para o
  palco — é ele que esconde a emenda.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path android:pathData="M0,0 H100 V100 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="50"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#E6FFF3D0" android:offset="0.16" />
                <item android:color="#66E8C468" android:offset="0.42" />
                <item android:color="#00E8C468" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
