<?xml version="1.0" encoding="utf-8"?>
<!-- Carta bloqueada: fundo escuro com leve brilho no centro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FF070B1F"
                android:startColor="#FF131A3D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.42"
                android:endColor="#00FFFFFF"
                android:gradientRadius="90dp"
                android:startColor="#1AFFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
