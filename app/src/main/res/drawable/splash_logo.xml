<?xml version="1.0" encoding="utf-8"?>
<!--
  O olho do Vigia: o selo que abre o app. Halo dourado, anel externo, bezel de
  marcações, a amêndoa do olho, a íris azul, a pupila em estrela e os glints.

  Os estados iniciais (trimPath/alpha/escala zerados) existem para o AVD de
  splash_logo_animated.xml abrir o olho peça por peça — visto parado, este
  vetor mostra só o halo apagado.

  O desenho é feito na escala natural (halo no raio 52) e o grupo "fit" encolhe
  tudo para dentro do raio 36: o Android recorta o ícone do splash no terço
  interno do viewport, e sem isso o anel e as marcações sumiriam e o halo
  terminaria num disco de borda dura no corte.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="root"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.94"
        android:scaleY="0.94">

        <!-- Área segura do ícone do splash: raio 52 do desenho vira raio 36. -->
        <group
            android:name="fit"
            android:pivotX="54"
            android:pivotY="54"
            android:scaleX="0.69"
            android:scaleY="0.69">

            <!-- Halo: brilho difuso que assenta o selo no fundo espacial. -->
            <path
                android:name="halo"
                android:fillAlpha="0"
                android:pathData="M54,2 A52,52 0 1,1 54,106 A52,52 0 1,1 54,2 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:centerX="54"
                        android:centerY="54"
                        android:gradientRadius="52"
                        android:type="radial">
                        <item
                            android:color="#4DE8C468"
                            android:offset="0.0" />
                        <item
                            android:color="#1FE8C468"
                            android:offset="0.5" />
                        <item
                            android:color="#00E8C468"
                            android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Bezel: marcações finas nas oito direções, giram até se alinharem. -->
            <group
                android:name="ticks"
                android:pivotX="54"
                android:pivotY="54"
                android:rotation="-14">
                <path
                    android:name="ticksPath"
                    android:pathData="M99,54 L103,54 M85.82,85.82 L88.65,88.65 M54,99 L54,103 M22.18,85.82 L19.35,88.65 M9,54 L5,54 M22.18,22.18 L19.35,19.35 M54,9 L54,5 M85.82,22.18 L88.65,19.35"
                    android:strokeAlpha="0"
                    android:strokeColor="#E8C468"
                    android:strokeLineCap="round"
                    android:strokeWidth="1.4" />
            </group>

            <!-- Anel externo: a órbita do observador, desenhada no sentido horário. -->
            <path
                android:name="ringOuter"
                android:pathData="M54,12 A42,42 0 1,1 54,96 A42,42 0 1,1 54,12"
                android:strokeAlpha="0.85"
                android:strokeColor="#E8C468"
                android:strokeLineCap="round"
                android:strokeWidth="1.5"
                android:trimPathEnd="0" />

            <!-- Amêndoa: o contorno do olho, traçado de uma ponta à outra. -->
            <path
                android:name="lid"
                android:pathData="M18,54 C31,34 77,34 90,54 C77,74 31,74 18,54 Z"
                android:strokeColor="#E8C468"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:strokeWidth="2.4"
                android:trimPathEnd="0" />

            <!-- Íris: azul do app, mais clara no centro. Abre depois da amêndoa. -->
            <group
                android:name="iris"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:name="irisPath"
                    android:pathData="M54,41 A13,13 0 1,1 54,67 A13,13 0 1,1 54,41 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:centerX="54"
                            android:centerY="54"
                            android:gradientRadius="13"
                            android:type="radial">
                            <item
                                android:color="#FF5B8CFF"
                                android:offset="0.0" />
                            <item
                                android:color="#FF1957D8"
                                android:offset="0.65" />
                            <item
                                android:color="#FF0B2E7A"
                                android:offset="1.0" />
                        </gradient>
                    </aapt:attr>
                </path>
                <path
                    android:name="irisRing"
                    android:pathData="M54,41 A13,13 0 1,1 54,67 A13,13 0 1,1 54,41 Z"
                    android:strokeAlpha="0.7"
                    android:strokeColor="#9FBEFF"
                    android:strokeWidth="0.9" />
            </group>

            <!-- Pupila: estrela de quatro pontas — a última peça a assentar. -->
            <group
                android:name="pupil"
                android:pivotX="54"
                android:pivotY="54"
                android:rotation="-45"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:name="pupilPath"
                    android:fillColor="#F6DE9A"
                    android:pathData="M54,45 C55,50.5 57.5,53 63,54 C57.5,55 55,57.5 54,63 C53,57.5 50.5,55 45,54 C50.5,53 53,50.5 54,45 Z" />
            </group>

            <!-- Glints: o reflexo que dá vida ao olho. -->
            <path
                android:name="glintBig"
                android:fillAlpha="0"
                android:fillColor="#FFFFFF"
                android:pathData="M47.5,47.5 A2.4,2.4 0 1,1 47.5,52.3 A2.4,2.4 0 1,1 47.5,47.5 Z" />
            <path
                android:name="glintSmall"
                android:fillAlpha="0"
                android:fillColor="#FFFFFF"
                android:pathData="M60.5,59.5 A1.3,1.3 0 1,1 60.5,62.1 A1.3,1.3 0 1,1 60.5,59.5 Z" />
        </group>
    </group>
</vector>
