<?xml version="1.0" encoding="utf-8"?>
<!--
  Ficha do herói: fundo desfocado da própria arte atrás da barra de status,
  pôster em destaque, nome e selos, números e as seções montadas em código
  (identidade, biografia, poderes, relações, aparições, imagem e registro).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vigia_space"
    tools:ignore="Overdraw">

    <!-- Fundo: arte desfocada que fica parada enquanto o conteúdo rola por cima. -->
    <ImageView
        android:id="@+id/imageBackdrop"
        android:layout_width="0dp"
        android:layout_height="@dimen/hero_backdrop_height"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/backdropScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_backdrop_scrim"
        app:layout_constraintBottom_toBottomOf="@id/imageBackdrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="@dimen/hero_poster_top"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/hero_content_max_width">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/posterCard"
                    android:layout_width="@dimen/hero_poster_width"
                    android:layout_height="@dimen/hero_poster_height"
                    android:clickable="true"
                    android:contentDescription="@string/hero_cd_poster"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/vigia_panel_solid"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="16dp"
                    app:strokeColor="@color/vigia_gold"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/imagePoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_icon_scrim"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/ic_zoom" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="Lizard" />

                <TextView
                    android:id="@+id/tvRealName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/white_70"
                    android:textSize="16sp"
                    tools:text="Curtis Connors" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="6dp" />

                <TextView
                    android:id="@+id/tvDeck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/white"
                    android:textIsSelectable="true"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    tools:text="During an experiment, Dr. Curtis Connors accidentally turned himself into a ferocious reptilian monster." />

                <!-- Aviso da tradução automática: andamento e atalho para o texto original. -->
                <LinearLayout
                    android:id="@+id/translationBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip_scrim"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/translationProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:indeterminate="true"
                        app:indicatorColor="@color/vigia_gold"
                        app:indicatorSize="14dp"
                        app:trackThickness="2dp" />

                    <TextView
                        android:id="@+id/tvTranslation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingVertical="8dp"
                        android:textColor="@color/white_70"
                        android:textSize="12sp"
                        tools:text="Traduzido automaticamente do inglês" />

                    <Button
                        android:id="@+id/btnTranslationAction"
                        style="@style/Widget.OVigia.TextAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        tools:text="Ver original" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOffline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip_scrim"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/hero_offline_copy"
                    android:textColor="@color/white_70"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/statsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <include
                        android:id="@+id/statAppearances"
                        layout="@layout/item_profile_stat" />

                    <Space
                        android:layout_width="@dimen/gap"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/statTeams"
                        layout="@layout/item_profile_stat" />

                    <Space
                        android:layout_width="@dimen/gap"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/statPowers"
                        layout="@layout/item_profile_stat" />
                </LinearLayout>

                <!-- Seções montadas em código, só com o que a API trouxe. -->
                <LinearLayout
                    android:id="@+id/sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Carregando / erro / bloqueado -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/vigia_gold" />

                <LinearLayout
                    android:id="@+id/messageBox"
                    style="@style/Widget.OVigia.DashboardCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        tools:text="@string/error_no_connection" />

                    <Button
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:paddingHorizontal="28dp"
                        android:text="@string/btn_retry" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAttribution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:text="@string/hero_attribution"
                    android:textColor="@color/white_50"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra superior: transparente sobre a arte, fica sólida (com o nome) ao rolar. -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vigia_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.OVigia.IconButton.Scrim"
            android:layout_gravity="start|center_vertical"
            android:layout_margin="@dimen/bar_margin"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvBarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="72dp"
            android:alpha="0"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:alpha="1"
            tools:text="Lizard" />

        <ImageButton
            android:id="@+id/btnOpenWeb"
            style="@style/Widget.OVigia.IconButton.Scrim"
            android:layout_gravity="end|center_vertical"
            android:layout_margin="@dimen/bar_margin"
            android:contentDescription="@string/hero_cd_open_web"
            android:src="@drawable/ic_open_in_new"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
