<?xml version="1.0" encoding="utf-8"?>
<!--
  Linha de jogador na aba de amigos: foto, nome e @usuario, e as ações da vez
  (adicionar, aceitar/recusar, cancelar ou só a seta para abrir o perfil).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_alternative"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">

    <FrameLayout
        android:layout_width="@dimen/avatar_friend"
        android:layout_height="@dimen/avatar_friend"
        android:background="@drawable/bg_profile_avatar"
        android:importantForAccessibility="no"
        android:padding="2dp">

        <ImageView
            android:id="@+id/imageAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:tint="@color/vigia_gold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Ana Lima" />

        <TextView
            android:id="@+id/tvDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white_70"
            android:textSize="14sp"
            tools:text="\@analima" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        style="@style/Widget.OVigia.Button.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        tools:text="@string/friends_action_accept"
        tools:visibility="visible" />

    <!-- Descrição e ação trocam em código (recusar ou cancelar pedido). -->
    <ImageButton
        android:id="@+id/btnSecondary"
        style="@style/Widget.OVigia.IconButton"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/friends_action_decline"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:tint="@color/white_70"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:textColor="@color/vigia_gold"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="@string/friends_status_friends" />

    <ImageView
        android:id="@+id/imageChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/white_70" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/rowProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/vigia_gold"
        app:indicatorSize="24dp"
        app:trackThickness="3dp" />
</LinearLayout>
